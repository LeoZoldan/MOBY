{
  "expo": {
    "name": "motoapp",
    "slug": "motoapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "motoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lfz87.motoapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "pk.eyJ1IjoibGVvem9sZGFuIiwiYSI6ImNtcTZ3aWpqMDAxZWUycnB2N2V0NzA2c2sifQ.JIdw2ojpfvyPpDJrUiA91A"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita que o MOBY acesse sua localização para mostrar corridas próximas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2cbdcd76-8578-4d0b-b606-8e2e16beb7f6"
      },
      "mapboxAccessToken": "pk.eyJ1IjoibGVvem9sZGFuIiwiYSI6ImNtcTZ3aWpqMDAxZWUycnB2N2V0NzA2c2sifQ.JIdw2ojpfvyPpDJrUiA91A"
    }
  }
}